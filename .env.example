# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채우세요. (.env는 git에 올라가지 않아요)
# Render에 배포할 때는 이 파일 대신 Render 대시보드의 Environment 메뉴에 같은 이름으로 넣어요.

# 데이터베이스 (배포용 Postgres). 비우면 내 컴퓨터의 data/stockfit.db(SQLite)를 써요.
# Neon: 프로젝트 만들기 → Connection string 복사 (postgresql://...?sslmode=require 형태)
DATABASE_URL=

# DART 오픈API 인증키 (https://opendart.fss.or.kr). 비우면 예시 데이터 3종목으로 동작
DART_API_KEY=

# 공공데이터포털 "금융위원회_주식시세정보" (주가 변동성·위험 등급·PER·PBR)
# https://www.data.go.kr → "금융위원회_주식시세정보" 검색 → 활용신청 → 마이페이지에서 일반 인증키 복사
# 인코딩 키, 디코딩 키 어느 쪽을 넣어도 돼요. 비우면 가격 수준·주가 안정성은 빼고 계산해요.
DATA_GO_KR_KEY=

# 한국은행 ECOS (기준금리, 국고채 3년 금리). https://ecos.bok.or.kr/api → 인증키 신청
# 비우면 금리 반영 없이 계산해요.
ECOS_API_KEY=

# AI 도우미 (OpenAI). https://platform.openai.com → API keys 에서 발급, 결제 수단 등록 필요
# 비우면 화면에 도우미 버튼이 보이지 않아요. 모델은 저렴한 소형 모델이 기본이고, 바꾸려면 OPENAI_MODEL에 이름을 적어요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 로그인한 회원만 사용, 한 계정 10분에 20번. 사이트 전체 하루 질문 수 상한 (비용 관리)
CHAT_DAILY_LIMIT=300

# 네이버 검색 API (종목 뉴스). 2026년부터 네이버클라우드 "NAVER API HUB"에서 발급해요 (개발자센터 X)
# 네이버클라우드 콘솔 → Services → NAVER API HUB → Application 등록 → 검색(뉴스) 선택 → 인증 정보의 Client ID/Secret
# 비우면 뉴스는 빼고 공시만 보여줘요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 메일 발송 (이메일 인증, 비밀번호 찾기). 비우면 이 두 기능은 꺼지고 가입·로그인만 동작해요.
# SSL(465) 포트만 지원해요.
#   Gmail: SMTP_HOST=smtp.gmail.com  / SMTP_PASS에는 구글 계정의 "앱 비밀번호"(16자리)
#   네이버: SMTP_HOST=smtp.naver.com / 네이버 메일 환경설정에서 POP3/SMTP 사용 켜기
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 보내는 사람 주소 (비우면 SMTP_USER)
MAIL_FROM=

# 메일 속 링크의 사이트 주소 (비우면 http://localhost:3000)
APP_URL=
